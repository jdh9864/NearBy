# 프론트(Vite) 환경변수. Vercel 프로젝트 Settings > Environment Variables 에 동일하게 넣고 빌드할 것.
# ⚠️ Vite 는 빌드 시점에 값을 코드에 박아넣음 -> 값이 바뀌면 반드시 재빌드/재배포.

# 백엔드 주소 (클라우드플레어 터널). 끝에 슬래시 없이.
VITE_API_BASE_URL=https://your-tunnel.trycloudflare.com

# 카카오 REST API 키 (= 서버 .env 의 KAKAO_CLIENT_ID 와 동일). 로그인 authorize 용.
VITE_KAKAO_REST_KEY=카카오_REST_API_키

# 카카오 로그인 redirect_uri.
# (1) 카카오 콘솔 등록값 (2) 서버 .env 의 KAKAO_REDIRECT_URI 와 글자까지 완전히 동일해야 함.
# 보통 Vercel 배포 주소(루트). 예: https://nearby-xxx.vercel.app
VITE_KAKAO_REDIRECT_URI=https://your-app.vercel.app

# 카카오 JavaScript 키 (지도 SDK 용. REST 키와 다름!)
VITE_KAKAO_JS_KEY=카카오_JavaScript_키

# 동네 채팅 법정동코드. 기본값 = 인천 미추홀구 용현동(인하대).
# dummy_data.sql 에 이 코드로 REGION 방이 시드돼 있어야 함.
VITE_REGION_CODE=2817710200
